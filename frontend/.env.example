# Wolf Goat Pig Frontend Environment Variables
# Copy this file to .env.local for local development

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
# Local development: Leave empty (uses localhost:8000)
# Production builds set this in GitHub Actions for Firebase Hosting.
VITE_API_URL=

# ============================================================================
# AUTH0 CONFIGURATION
# ============================================================================
VITE_AUTH0_DOMAIN=dev-jm88n088hpt7oe48.us.auth0.com
VITE_AUTH0_CLIENT_ID=qAZuRv5E9mPQ9uTGg7NWpkpfVj8bCeoB
# This is Auth0's stable API identifier, not an active Render endpoint.
VITE_AUTH0_AUDIENCE=https://wolf-goat-pig.onrender.com

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# ============================================================================
# DEPLOYMENT METADATA (Optional)
# ============================================================================
# Deployment platform (auto-detected but can be overridden)
VITE_DEPLOY_PLATFORM=local

